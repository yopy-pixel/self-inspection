<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      使用状況へのアクセス権限。
      これは通常の実行時権限ダイアログでは取得できず、
      「設定 > 使用状況へのアクセス」で手動許可が必要（AppOpsManager で判定する）。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 再起動後に収集を再開するため -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- サーバー同期のためのネットワークアクセス -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      12時間ごとの通知（PLAN-android.md Phase 3）。
      targetSdk 34 のため実行時許可が必要（API 33+）。
      未許可でもアプリの他の機能は全て動く。
      **FCM は使わない。** サーバーを介さず端末内で完結させる
      （通知のためにデータを外に出さないため）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelfKaizen"
        tools:targetApi="m"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          端末再起動後に収集スケジュールを再登録する。
          exported="false" が必須（外部アプリから起動される必要がない）。
        -->
        <receiver
            android:name=".work.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          標準ウィジェット（SPEC §7「本命の介入点」）。

          `exported="true"` が必須。ホーム画面（別プロセス）から
          ブロードキャストされるため。外部アプリに機能を晒すわけではなく、
          AppWidget の仕組み上こうする必要がある。
          `APPWIDGET_UPDATE` 以外は受け取らない。
        -->
        <receiver
            android:name=".widget.UsageWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_usage_info" />
        </receiver>

        <!-- ミニウィジェット。狭い場所向け（今日の量とバーだけ）。 -->
        <receiver
            android:name=".widget.UsageWidgetMiniProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_usage_mini_info" />
        </receiver>

        <!--
          12時間ごとの通知アラームを受け取る。
          `exported="false"` が必須。この Intent は自分自身の
          `PendingIntent` からしか飛んでこないため、外部に開く必要がない。
        -->
        <receiver
            android:name=".notify.NotifyAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
